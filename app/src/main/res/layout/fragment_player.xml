<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101116">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="true"
        app:controller_auto_show="true"
        app:controller_show_timeout="5000"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <ImageButton
        android:id="@+id/pip_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#66000000"
        android:contentDescription="@string/nav_media"
        android:src="@android:drawable/ic_menu_view"
        android:tint="@android:color/white"
        android:visibility="gone" />

    <Button
        android:id="@+id/options_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:text="İndirme seçenekleri" />

    <TextView
        android:id="@+id/player_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#99000000"
        android:padding="10dp"
        android:text="@string/main_status_ready"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:visibility="visible" />
</FrameLayout>