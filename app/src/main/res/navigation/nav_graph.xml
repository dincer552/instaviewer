<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/home_fragment">

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.HomeFragment"
        android:label="@string/nav_home" >
        <action
            android:id="@+id/action_navigation_home_to_player"
            app:destination="@id/player_fragment" />
    </fragment>

    <fragment
        android:id="@+id/media_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.MediaFragment"
        android:label="@string/nav_media" />

    <fragment
        android:id="@+id/downloads_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.DownloadsFragment"
        android:label="@string/nav_downloads" />

    <fragment
        android:id="@+id/favorites_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.FavoritesFragment"
        android:label="@string/nav_favorites" />

    <fragment
        android:id="@+id/settings_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/player_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.PlayerFragment"
        android:label="@string/nav_media" />
</navigation>