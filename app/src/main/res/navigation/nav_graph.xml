<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/home_fragment">

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.HomeFragment"
        android:label="@string/nav_home" >
        <action
            android:id="@+id/action_navigation_home_to_player"
            app:destination="@id/player_fragment" />
    </fragment>

    <fragment
        android:id="@+id/player_fragment"
        android:name="com.dincer552.instaviewer.ui.screens.PlayerFragment"
        android:label="@string/nav_media" />
</navigation>