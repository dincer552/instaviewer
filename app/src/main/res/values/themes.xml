<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LinkViewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/amoledPanel</item>
        <item name="colorOnPrimaryContainer">@color/textPrimary</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/amoledBlack</item>

        <item name="colorTertiary">@color/colorSecondary</item>
        <item name="colorTertiaryContainer">@color/amoledPanel</item>
        <item name="colorOnTertiary">@color/colorOnSecondary</item>
        <item name="colorOnTertiaryContainer">@color/textPrimary</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>

        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnSurface</item>

        <item name="colorError">@color/colorError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnError">@color/amoledBlack</item>
        <item name="colorOnErrorContainer">@color/colorError</item>

        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="elevationOverlayEnabled">true</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.LinkViewer.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.LinkViewer.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.LinkViewer.Large</item>

        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="ShapeAppearance.LinkViewer.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.LinkViewer.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.LinkViewer.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.LinkViewer.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/amoledPanel</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.LinkViewer.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/amoledPanel</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LinkViewer.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.LinkViewer.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.LinkViewer.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/amoledChipBg</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.LinkViewer.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/amoledChipBg</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <style name="Widget.LinkViewer.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/amoledInputBg</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/textHint</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Widget.LinkViewer.BottomNavigation" parent="Widget.Material3.Bottom NavigationView">
        <item name="backgroundTint">@color/amoledPanel</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/colorPrimary</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.LinkViewer.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/colorPrimary</item>
        <item name="trackColor">@color/progressInactive</item>
        <item name="trackThickness">3dp</item>
    </style>
</resources>